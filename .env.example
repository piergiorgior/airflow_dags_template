# ============================================================
#  Copy this file to .env and adjust values as needed
#  .env is already in .gitignore — never commit secrets!
# ============================================================

# Required: your local user ID (run: id -u)
AIRFLOW_UID=50000

# Airflow web UI credentials
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin
# Extra pip packages to install at container startup (space-separated)
# Example: _PIP_ADDITIONAL_REQUIREMENTS=apache-airflow-providers-clickhouse pandas
_PIP_ADDITIONAL_REQUIREMENTS=
